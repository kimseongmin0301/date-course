# .env 파일을 이 형식으로 만들어 주세요. (.env 는 git 에 올라가지 않습니다)

# ===== PostgreSQL =====
# 힐링룸과 같은 DB(healing_room)·계정을 쓰고, 이 앱의 테이블은 전용 스키마(date_course)에만 둔다
# DB_HOST ~ DB_PASSWORD 는 힐링룸 .env 와 같은 값
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healing_room
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=date_course

# ===== Redis (캐시) =====
# 힐링룸과 같은 Redis·계정. 이 계정은 healing-room: 로 시작하는 키만 쓸 수 있어 키 접두어를 healing-room:date-course: 로 둔다
# REDIS_HOST ~ REDIS_DATABASE 는 힐링룸 .env 와 같은 값
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=1
REDIS_KEY_PREFIX=healing-room:date-course:

# ===== 한국관광공사 TourAPI (국문 관광정보 서비스, KorService2) =====
# 공공데이터포털 > 마이페이지 > 데이터활용 > 활용신청 상세 화면의 값
# End Point
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# 일반 인증키: Encoding·Decoding 두 가지 중 Decoding 키(%2F 같은 글자가 없는 쪽). 요청할 때 코드가 인코딩한다
TOUR_API_SERVICE_KEY=

# ===== 상가(상권)정보 =====
# 키 없이 CSV 파일로 받는다 (공공데이터포털 15083033, 분기마다 갱신)

# -- 네이버 클라우드 Maps (Geocoding: 주소 검색, 서버에서만 부름) --
# 콘솔 > Maps > Application 의 인증 정보. Client ID 는 화면 지도 키(VITE_NAVER_MAP_KEY_ID)와 같은 값,
# Client Secret 은 서버에만 둔다 (화면·저장소에 넣지 않음). API 선택에서 Geocoding 을 켜야 한다
# 무료 이용량은 대표 계정 1개에 월 3,000,000건. 콘솔 이용 한도도 그 이하로 걸어 둔다
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# -- NAVER API HUB 검색 API (지역 검색: 가게 이름으로 찾기, 서버에서만 부름) --
# 콘솔 > NAVER API HUB > Application 등록(검색 API 선택) > 인증 정보. Maps 와 다른 키다
# Application 의 API 선택에서 "지역"과 "이미지"를 켠다 (둘이 하루 25,000건을 나눠 씀)
# 무료: 0~775,000건, 하루 최대 25,000건. 비우면 "네이버에서 찾기"·"네이버 이미지 보기"만 꺼진다
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
